DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://sip:sip@postgres:5432/sip

SIP_PROVIDER=asterisk
SIP_DIALPLAN_CONTEXT=from-internal

ARI_BASE_URL=http://asterisk:8088/ari
ARI_WS_URL=ws://asterisk:8088/ari/events
ARI_USER=sipapp
ARI_PASSWORD=sippass
ARI_APP=sip_app

# Avto-qo'ng'iroq / audio
# Telefonsiz sinash: SIP_DIAL_TEMPLATE=Local/{number}@demo-answer  (docker/asterisk/extensions.conf)
SIP_DIAL_TEMPLATE=PJSIP/{number}
MAX_UPLOAD_MB=25
REPLY_MAX_SECONDS=60
REPLY_MAX_SILENCE=4

# Matnga o'tkazish (OpenAI-mos API: OpenAI, Groq yoki lokal Whisper). Kalit bo'sh bo'lsa o'chiq.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=uz
